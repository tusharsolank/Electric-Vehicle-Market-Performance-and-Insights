  <dashboards>
    <dashboard name='Electric Vehicle Market Analysis' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='1926' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98120' id='1' param='vert' removable='false' type-v2='layout-flow' w='99034' x='483' y='940'>
            <zone h='4935' id='3' type-v2='title' w='99034' x='483' y='940' />
            <zone fixed-size='108' h='12691' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99034' x='483' y='5875' />
            <zone h='80494' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99034' x='483' y='18566'>
              <flipboard active-id='2' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='This story explores electric vehicle sales, driving range, battery capacity, and customer ratings to understand differences across vehicle categories and manufactures.' captured-sheet='Electric Vehicle Market Analysis Dashboard' id='2'>
                    <capturedDeltas>
                      <worksheet name='Annual EV Sales by Category'>
                        <filter class='categorical' column='[federated.1qx3s4o0ejodh713mpvkv1yiodj3].[Action (Manufacturer)]'>
                          <groupfilter function='level-members' level='[manufacturer]' user:ui-action-filter='[Action1_515CCF0C4745475ABBC3FCC3B4838378]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                        </filter>
                      </worksheet>
                      <worksheet name='Average Battery Capacity by Type'>
                        <filter class='categorical' column='[federated.1qx3s4o0ejodh713mpvkv1yiodj3].[Action (Manufacturer)]'>
                          <groupfilter function='level-members' level='[manufacturer]' user:ui-action-filter='[Action1_515CCF0C4745475ABBC3FCC3B4838378]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                        </filter>
                      </worksheet>
                      <worksheet name='Average Driving Range by EV Category (KM)'>
                        <filter class='categorical' column='[federated.1qx3s4o0ejodh713mpvkv1yiodj3].[Action (Manufacturer)]'>
                          <groupfilter function='level-members' level='[manufacturer]' user:ui-action-filter='[Action1_515CCF0C4745475ABBC3FCC3B4838378]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                        </filter>
                      </worksheet>
                      <worksheet name='Battery Weight by Battery Type'>
                        <filter class='categorical' column='[federated.1qx3s4o0ejodh713mpvkv1yiodj3].[Action (Manufacturer)]'>
                          <groupfilter function='level-members' level='[manufacturer]' user:ui-action-filter='[Action1_515CCF0C4745475ABBC3FCC3B4838378]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                        </filter>
                      </worksheet>
                      <worksheet name='Customer Ratings by Manufacturer'>
                        <selection-collection />
                      </worksheet>
                    </capturedDeltas>
                  </story-point>
                  <story-point caption='                                                                                     Explain which categories have the highest recorded sales in your dataset.' captured-sheet='Annual EV Sales by Category' id='3' />
                  <story-point caption='                                                                                                          Average Driving Range by EV Category.' captured-sheet='Average Driving Range by EV Category (KM)' id='4' />
                  <story-point caption='                                                                                                           Comparison of Battery Weight by Battery Type. ' captured-sheet='Battery Weight by Battery Type' id='5' />
                  <story-point caption='                                                                 Analysis of Average Battery Capacity' captured-sheet='Average Battery Capacity by Type' id='6' />
                  <story-point caption='                                                                                                                              Customer Satisfaction Analysis by Manufacturer' captured-sheet='Customer Ratings by Manufacturer' id='7' />
                  <story-point captured-sheet='Electric Vehicle Market Analysis Dashboard' id='8' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='33843' hidden='true' id='6' story-point-id='5' type-v2='text' w='96560' x='-60' y='44771'>
          <formatted-text>
            <run>This visuallization compares the total weight of different electric vehicle battery types. The analysis shows that NMC and LFP batteries contribute a higher share of total battery wight, while Sodium-Ion and Solid-State batteries have comparatively lower weight in this dataset.
This comparison helps understand the distribution of battery weight across different battery technologies.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='30082' hidden='true' id='7' story-point-id='6' type-v2='text' w='92034' x='4345' y='54994'>
          <formatted-text>
            <run>This chart compares the average battery capacity across different battery types. Solid-State batteries show the highest average capacity in the displayed data, while other battery technologies have slightly lower capacity levels.Higher battery capacity can help electric vehicles achieve better driving ranges, depending on vehicle efficiency.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='26322' hidden='true' id='8' story-point-id='7' type-v2='text' w='91249' x='3983' y='54524'>
          <formatted-text>
            <run>This visualization compares average customer ratings across different EV manufactures. The chart shows that customer ratings are relatively similar across manufacturers, indicating a consistent level of customer satisfaction in the displayed data.This analysis helps understand customer experience and brand performance in the electric vehicle market.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' h='26322' hidden='true' id='9' story-point-id='3' type-v2='text' w='95112' x='2595' y='65217'>
          <formatted-text>
            <run>This chart represents annual electric vehicle sales across different vehicle categories. It highlights the categories with higher and lower sales volumes.
The visualization helps identify popular EV segments and understand market demand for different types of electric vehicles.</run>
          </formatted-text>
        </zone>
        <zone flipboard-zone-id='5' forceUpdate='true' h='30082' hidden='true' id='10' story-point-id='4' type-v2='text' w='94025' x='3078' y='64395'>
          <formatted-text>
            <run>This visualization compares the average driving range of different electric vehicle categories. Luxury Sedan and Luxury SUV show the highest average driving ranges,while smaller vehicle categories such as Two-Wheeler Scooters and Three-Wheelers have comparatively lower ranges.This analysis helps customers identify EV categories that  offer better driving range.</run>
          </formatted-text>
        </zone>
      </zones>
      <simple-id uuid='{FA366848-9C0A-44E8-88D1-EBF8709B3D82}' />
    </dashboard>
